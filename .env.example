# Shared by the web process and separate worker. Never commit .env.
COS_ENV=development
COS_BASE_URL=http://127.0.0.1:5087
PORT=5087
COS_SIGNUP_ENABLED=1
MONGODB_URI=
MONGODB_DATABASE=chief_of_staff
# Generate once and keep stable; see deploy/README.md.
FLASK_SECRET_KEY=
COS_ENCRYPTION_KEY=

# Account verification, password reset, invitations (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Choose Anthropic OR Amazon Bedrock. Sample simulation needs neither.
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-4-5-20250929
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# For Bedrock use an AWS workload role or standard AWS credentials.

# Operator configures OAuth apps once; customers authorize their accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: run briefings on a deployed Bedrock AgentCore Runtime instead of
# in-process. See deploy/agentcore_runtime_entrypoint.py and deploy/README.md.
AGENTCORE_RUNTIME_ARN=
AGENTCORE_CALLBACK_SECRET=

# Optional: Dodo Payments billing (Pro/Team upgrades). Leave blank to disable
# checkout; the trial plan and its briefing cap still apply either way.
DODO_ENV=test
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRO_PRODUCT_ID=
DODO_TEAM_PRODUCT_ID=
